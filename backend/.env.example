# PostgreSQL Database
DATABASE_URL=postgresql://mailchat_user:mailchat_pass@localhost:5432/mailchat?schema=public

# Server Configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=8787

# Logging
LOG_LEVEL=debug

# JWT Session Secret (change in production!)
JWT_SECRET=dev-secret-key-change-in-production-min-32-chars

# CORS - Update for production
CORS_ORIGINS=http://localhost:3100,https://localhost:3100

# ============================================
# Google OAuth2 Configuration
# Get these from https://console.cloud.google.com/apis/credentials
# ============================================

# Google OAuth2 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Google OAuth2 Client Secret (from Google Cloud Console)
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Redirect URI - Update with your domain
GOOGLE_REDIRECT_URI=http://localhost:3100/auth/callback

# ============================================
# Gmail API Scopes (configured in OAuth consent screen)
# openid email https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.send
# ============================================

# Session Configuration
JWT_EXPIRES_IN=1h
SESSION_SECRET=your-session-secret-min-32-chars
SESSION_MAX_AGE=86400000

# ============================================
# Production Checklist
# ============================================
# 1. Replace GOOGLE_CLIENT_ID/SECRET with real values
# 2. Set GOOGLE_REDIRECT_URI to your HTTPS domain
# 3. Use strong JWT_SECRET in production
# 4. Configure HTTPS with Let's Encrypt
# 5. Verify domain in Google Cloud Console
# 6. Request CASA verification if needed
